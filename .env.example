# Add real credentials before enabling SMS login or paid checkout.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
OTP_SECRET=
ZARINPAL_MERCHANT_ID=
# Explicitly skip payment for new bookings, including paid sample events.
SKIP_PAY_DEV=false
APP_ORIGIN=
# Required for the Node/VPS target; keep the database outside release directories.
DATABASE_PATH=
# Required for image uploads on Node/VPS; keep files outside release directories.
MEDIA_PATH=
# Comma-separated verified Iranian mobile numbers permitted to host events.
HOST_PHONES=
# TODO(PRODUCTION): REMOVE_TEMP_LOGIN — enable only for local development or hosted demos.
TEMP_LOGIN_ENABLED=false
# User-authorized sample Tehran cafe events. Set false for an empty live catalog.
SEED_SAMPLE_EVENTS=true
